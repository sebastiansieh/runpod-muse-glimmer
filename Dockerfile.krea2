# Krea2-ready ComfyUI worker for RunPod Serverless
FROM runpod/worker-comfyui:5.10.0-base-cuda12.8.1

LABEL maintainer="sebastiansieh"
LABEL description="ComfyUI worker with Krea2 support"

# Update ComfyUI to latest nightly for Krea2 support
RUN comfy update all 2>/dev/null || true

# Pre-create Krea2 model directories (models come from network volume)
RUN mkdir -p /comfyui/models/diffusion_models \
             /comfyui/models/text_encoders \
             /comfyui/models/vae \
             /comfyui/models/loras

USER nobody
WORKDIR /comfyui

ENTRYPOINT ["/docker/entrypoint.sh"]
CMD ["comfy", "launch", "--background", "--listen", "0.0.0.0", "--port", "8188"]