# Krea2-ready ComfyUI worker for RunPod Serverless
FROM runpod/worker-comfyui:fix-dr-1170-ngc-base-blackwell-base-ngc26.05

LABEL maintainer="sebastiansieh"
LABEL description="ComfyUI worker with Krea2 support"

# Update ComfyUI to latest nightly at build time
WORKDIR /comfyui
RUN git fetch --tags --force 2>/dev/null; git pull origin master 2>/dev/null || true; \
    pip install --no-cache-dir -r requirements.txt 2>/dev/null || true; \
    pip install --no-cache-dir torch>=2.6.0 2>/dev/null || true

# Pre-create model directories with right ownership
RUN mkdir -p /comfyui/models/diffusion_models \
             /comfyui/models/text_encoders \
             /comfyui/models/vae \
             /comfyui/models/loras

USER nobody
WORKDIR /comfyui

ENTRYPOINT ["/docker/entrypoint.sh"]
CMD ["comfy", "launch", "--background", "--listen", "0.0.0.0", "--port", "8188"]